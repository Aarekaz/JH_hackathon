# AI Parliament Simulator - Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== OpenAI Configuration ====================
# Your OpenAI API key (required)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# OpenAI temperature setting (0.0-1.0, default: 0.7)
OPENAI_TEMPERATURE=0.7

# Max tokens per response (default: 500)
OPENAI_MAX_TOKENS=500


# ==================== Database Configuration ====================
# Database URL (default: SQLite)
# SQLite: sqlite:///./ai_parliament.db
# PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./ai_parliament.db


# ==================== Redis Configuration (Optional) ====================
# Redis URL for caching (leave empty to disable caching)
REDIS_URL=

# Enable Redis caching (true/false, default: false)
REDIS_ENABLED=false

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600


# ==================== Server Configuration ====================
# Debug mode (true/false, default: false)
# WARNING: Never set to true in production!
DEBUG=false

# Allowed CORS origins (comma-separated)
# Default: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# ==================== API Configuration ====================
# Rate limit (requests per minute, default: 10)
RATE_LIMIT_PER_MINUTE=10

# Maximum debate responses (default: 10)
MAX_DEBATE_RESPONSES=10


# ==================== Logging Configuration ====================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (default: logs/parliament.log)
LOG_FILE=logs/parliament.log


# ==================== Notes ====================
# 1. Never commit the actual .env file to version control
# 2. The .env file should be in .gitignore
# 3. Required variables: OPENAI_API_KEY
# 4. All other variables have sensible defaults
